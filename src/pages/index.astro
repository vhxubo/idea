---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const entries = projects.map((p, i) => ({ ...p, no: String(i + 1).padStart(2, "0") }));
---
<Layout>
  {/* 顶部工具条：同步状态 + 主题 + GitHub */}
  <header class="border-b border-hairline">
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3 sm:px-8">
      <p class="sync-line" id="sync-line" data-state="syncing">
        <span class="live-dot"></span>
        <span class="raw-path" id="sync-text">正在同步 raw.githubusercontent.com …</span>
      </p>
      <div class="ml-auto flex items-center gap-2.5">
        <a href="https://github.com/vhxubo?tab=repositories" target="_blank" rel="noopener noreferrer"
           class="grid h-9 w-9 place-items-center rounded-full border border-hairline text-muted transition hover:border-accent hover:text-accent"
           title="GitHub 仓库列表" aria-label="GitHub 仓库列表">
          <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        </a>
        <button id="theme-toggle"
                class="grid h-9 w-9 place-items-center rounded-full border border-hairline text-muted transition hover:border-accent hover:text-accent"
                title="主题: auto" aria-label="切换主题">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden h-4.5 w-4.5 dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2 12h2.5M19.5 12H22M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="block h-4 w-4 dark:hidden" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.34-.02-.67-.05-1a7 7 0 0 1-9.95-7.95A9 9 0 0 0 12 3Z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-24 pt-10 sm:px-8 lg:grid-cols-[18.5rem_1fr] lg:gap-14 lg:pt-16">
    {/* 侧栏：登记信息 + 筛选 */}
    <aside class="lg:sticky lg:top-10 lg:self-start">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">vhxubo · 开源登记簿</p>
      <h1 class="rail-title mt-3">Idea<span class="text-stamp">.</span></h1>
      <p class="rail-lede mt-5">
        这里登记 vhxubo 的开源项目。每份介绍与 README 都在打开时实时取自仓库的
        <a class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent" href="https://raw.githubusercontent.com/vhxubo/gift/main/README.md" target="_blank" rel="noopener noreferrer">GitHub raw</a> 原文——本站不存副本，仓库是唯一事实源。
      </p>

      <dl class="mt-7" id="stats">
        <div class="stat-row"><dt>登记项目</dt><dd>{projects.length}</dd></div>
        <div class="stat-row"><dt>Stars 合计</dt><dd data-stat="stars">—</dd></div>
        <div class="stat-row"><dt>语言</dt><dd data-stat="langs">—</dd></div>
        <div class="stat-row"><dt>最近推送</dt><dd data-stat="pushed">—</dd></div>
      </dl>

      <div class="mt-8">
        <label class="sr-only" for="search">搜索项目</label>
        <input id="search" type="search" class="search-input" placeholder="搜索项目 / 标签…" autocomplete="off" />
      </div>

      <div class="mt-5" role="group" aria-label="按标签筛选" id="tagfilter" hidden>
        <div class="flex flex-wrap gap-1.5" id="tagchips"></div>
      </div>

      <p class="colophon mt-8" id="count">共 {projects.length} 个项目</p>
    </aside>

    {/* 登记行 */}
    <section aria-label="项目列表">
      <div class="entries" id="entries">
        {entries.map((p, i) => (
          <article class="entry" data-repo={p.repo} data-topics="" style={`--i:${i}`}>
            <span class="entry-no">Nº {p.no}</span>
            <h2 class="entry-title">
              <button class="entry-open" data-open-repo={p.repo}>{p.repo}</button>
            </h2>
            <span class="entry-read">
              <button class="entry-open" data-open-repo={p.repo}>阅读 README →</button>
            </span>
            <p class="entry-note" data-slot="note">{p.note}</p>
            <div class="entry-meta">
              <span class="entry-tags" data-slot="tags" hidden></span>
              <span data-slot="lang" hidden></span>
              <span data-slot="stars" hidden></span>
              <span data-slot="updated" hidden></span>
              <a class="ml-auto" href={`https://github.com/vhxubo/${p.repo}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
          </article>
        ))}
        <p class="empty-note" id="empty" hidden>没有匹配的登记项</p>
      </div>
    </section>
  </div>

  {/* 页脚 */}
  <footer class="border-t border-hairline">
    <div class="colophon mx-auto max-w-6xl px-5 py-8 sm:px-8">
      <p>本页为静态站点，不含任何项目文案副本 · README 渲染自 raw.githubusercontent.com 的原文 · 项目版权归原作者所有</p>
      <p><a href={`${base}/`}>Idea</a> · <a href="https://github.com/vhxubo/idea" target="_blank" rel="noopener noreferrer">源码</a> · MIT</p>
    </div>
  </footer>

  {/* 溯源阅读器 */}
  <div class="backdrop" id="backdrop"></div>
  <aside class="reader" id="reader" role="dialog" aria-modal="true" aria-labelledby="reader-title">
    <div class="reader-head">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">原始文件 · README.md</p>
          <h2 class="reader-title mt-1" id="reader-title"></h2>
          <p class="reader-provenance">
            <span class="live-dot" id="reader-dot" style="background: var(--accent)"></span>
            <a class="raw-path" id="reader-raw" href="#" target="_blank" rel="noopener noreferrer" title="在 GitHub 打开原始文件"></a>
          </p>
        </div>
        <button class="reader-close" id="reader-close" aria-label="关闭阅读器">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px]">
        <a id="reader-gh" class="text-accent hover:underline underline-offset-4" href="#" target="_blank" rel="noopener noreferrer">在 GitHub 打开仓库 ↗</a>
        <a id="reader-home" class="text-muted hover:text-accent" href="#" target="_blank" rel="noopener noreferrer" hidden>访问线上地址 ↗</a>
      </div>
    </div>
    <div class="reader-body" id="reader-body">
      <div class="reader-state" id="reader-state"></div>
      <article class="md-body" id="md-body" hidden></article>
    </div>
  </aside>

  <script>
    import "../scripts/app.ts";
  </script>
  <script is:inline>
    // 三态轮转 light -> dark -> auto
    const apply = (t) => {
      const dark = t === "dark" || (t === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      localStorage.setItem("theme", t);
      document.getElementById("theme-toggle")?.setAttribute("title", `主题: ${t}`);
    };
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const order = ["light", "dark", "auto"];
      const cur = localStorage.getItem("theme") || "auto";
      apply(order[(order.indexOf(cur) + 1) % 3]);
    });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      if ((localStorage.getItem("theme") || "auto") === "auto") apply("auto");
    });
  </script>
</Layout>
