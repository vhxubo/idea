---
import Layout from "../layouts/Layout.astro";
import Search from "../components/Search.tsx";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const allTags = [...new Set(projects.flatMap((p) => p.tags))].sort();

const data = projects.map((p) => ({
  id: p.id,
  name: p.data.name,
  description: p.data.description,
  tags: p.data.tags,
  url: p.data.url,
}));
---
<Layout>
  <main class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <header class="mb-14">
      <div class="flex items-start justify-between gap-6">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ash dark:text-parchment/60">
            A commonplace book
          </p>
          <h1 class="mt-3 font-serif text-7xl leading-[0.95] tracking-tight sm:text-8xl">
            Idea<span class="text-sienna">.</span>
          </h1>
          <p class="mt-5 max-w-md font-serif text-xl italic text-ash dark:text-parchment/70">
            开发思想与项目集 —— 向最懒且最对的人学习。
          </p>
        </div>
        <button id="theme-toggle"
                class="shrink-0 w-10 h-10 rounded-full flex items-center justify-center border border-ink/15 text-ash hover:text-ink hover:border-ink/40 dark:text-parchment/60 dark:hover:text-parchment dark:border-parchment/15 dark:hover:border-parchment/40 transition"
                title="主题: auto" aria-label="切换主题">
          <!-- ponytail: inline SVG 太阳/月亮, 不引入图标库 -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5 hidden dark:block"><circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.2 4.2l1.4 1.4"/><path d="M18.4 18.4l1.4 1.4"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.2 19.8l1.4-1.4"/><path d="M18.4 5.6l1.4-1.4"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 block dark:hidden"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 18a8 8 0 0 1-5.2-3.5 8 8 0 0 1 0-9.3A8 8 0 0 1 12 4a8 8 0 0 1 8 8A8 8 0 0 1 12 20Z"/><path d="M12 4a8 8 0 1 0 8 8"/></svg>
        </button>
      </div>
    </header>

    <Search client:load projects={data} tags={allTags} />
  </main>

  <script is:inline>
    // ponytail: 三态轮转 light -> dark -> auto, 直接操作 data-theme, 不用状态库
    const apply = (t) => {
      const dark = t === "dark" || (t === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      localStorage.setItem("theme", t);
      const btn = document.getElementById("theme-toggle");
      if (btn) btn.title = `主题: ${t}`;
    };
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const order = ["light", "dark", "auto"];
      const cur = localStorage.getItem("theme") || "auto";
      apply(order[(order.indexOf(cur) + 1) % 3]);
    });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      if ((localStorage.getItem("theme") || "auto") === "auto") apply("auto");
    });
  </script>
</Layout>