---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  // ponytail: 去掉 .md 后缀, 让 URL 干净 (slug=ponytail 而非 ponytail.md)
  return projects.map((p) => ({
    params: { slug: p.id.replace(/\.md$/, "") },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { name, description, url, tags } = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout title={`${name} · Idea`}>
  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <a href={`${base}/`} class="mb-10 inline-block font-mono text-xs uppercase tracking-[0.15em] text-ash hover:text-sienna dark:text-parchment/60 dark:hover:text-sienna transition-colors">
      ← Index
    </a>

    <article>
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tags.map((t) => (
          <a href={`${base}/#tag=${encodeURIComponent(t)}`} class="font-mono text-[11px] px-2 py-0.5 rounded-full bg-ink/6 text-ash/80 hover:bg-sienna hover:text-white transition-colors dark:bg-parchment/10 dark:text-parchment/60">{t}</a>
        ))}
      </div>

      <h1 class="font-serif text-5xl leading-tight tracking-tight text-ink dark:text-parchment">{name}</h1>
      <p class="mt-4 font-serif text-xl italic text-ash dark:text-parchment/70">{description}</p>

      <a href={url} target="_blank" rel="noopener noreferrer"
         class="mt-8 inline-flex items-center gap-2 border-b border-sienna font-sans text-sm font-medium text-sienna hover:gap-3 transition-all">
        打开外部项目 <span class="font-mono">↗</span>
      </a>

      <hr class="my-10 border-ink/10 dark:border-parchment/10" />

      <div class="prose prose-slate dark:prose-invert max-w-none
                  prose-headings:font-serif prose-headings:text-ink dark:prose-headings:text-parchment
                  prose-h1:text-3xl prose-h2:text-2xl
                  prose-a:text-sienna prose-strong:text-ink dark:prose-strong:text-parchment
                  prose-code:font-mono prose-code:text-sienna prose-code:bg-ink/6 dark:prose-code:bg-parchment/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
                  prose-pre:bg-ink/4 dark:prose-pre:bg-moss-tone prose-pre:rounded-xl prose-pre:border prose-pre:border-ink/8 dark:prose-pre:border-parchment/10
                  prose-p:text-ash dark:prose-p:text-parchment/70 prose-p:leading-relaxed">
        <Content />
      </div>
    </article>
  </main>
</Layout>