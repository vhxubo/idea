[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.18.2","content-config-digest","23c09976a150c52c","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"actionBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","projects",["Map",11,12,34,35,55,56,78,79],"ast-grep",{"id":11,"data":13,"body":21,"filePath":22,"digest":23,"rendered":24,"legacyId":33},{"name":11,"description":14,"url":15,"tags":16},"用 AST 模式做结构化代码搜索和替换——比正则精准，比手动改文件高效","https://ast-grep.github.io/",[17,18,19,20],"工具","代码搜索","AST","重构","ast-grep 允许你用代码片段作为搜索模式（而不是正则），然后在整个代码库中匹配 AST 结构相同的节点。它能做到正则做不到的事：\n\n- 搜索\"所有调用 `foo(a, ...)` 的地方\"，不管参数名是什么\n- 批量替换\"把 `var x = ...` 改成 `const x = ...`\"，但只针对特定文件类型\n- 用 YAML 规则文件定义复杂的重构模式\n\n核心优势：模式就是你想要的代码形状，ast-grep 自动理解语义结构而非字符串。配合 CodeGraph，前者做文本/语义替换，后者做结构化查询，覆盖代码库操作的全场景。","src/content/projects/ast-grep.md","ddb0e7d717bdf518",{"html":25,"metadata":26},"\u003Cp>ast-grep 允许你用代码片段作为搜索模式（而不是正则），然后在整个代码库中匹配 AST 结构相同的节点。它能做到正则做不到的事：\u003C/p>\n\u003Cul>\n\u003Cli>搜索”所有调用 \u003Ccode>foo(a, ...)\u003C/code> 的地方”，不管参数名是什么\u003C/li>\n\u003Cli>批量替换”把 \u003Ccode>var x = ...\u003C/code> 改成 \u003Ccode>const x = ...\u003C/code>”，但只针对特定文件类型\u003C/li>\n\u003Cli>用 YAML 规则文件定义复杂的重构模式\u003C/li>\n\u003C/ul>\n\u003Cp>核心优势：模式就是你想要的代码形状，ast-grep 自动理解语义结构而非字符串。配合 CodeGraph，前者做文本/语义替换，后者做结构化查询，覆盖代码库操作的全场景。\u003C/p>",{"headings":27,"localImagePaths":28,"remoteImagePaths":29,"frontmatter":30,"imagePaths":32},[],[],[],{"name":11,"description":14,"url":15,"tags":31},[17,18,19,20],[],"ast-grep.md","codegraph",{"id":34,"data":36,"body":42,"filePath":43,"digest":44,"rendered":45,"legacyId":54},{"name":37,"description":38,"url":39,"tags":40},"CodeGraph","基于 tree-sitter 的代码知识图谱——毫秒级回答\"谁调用了这个函数\"之类的结构性问题","https://github.com/vhxubo/codegraph",[17,41,19],"代码分析","CodeGraph 把整个代码库解析成 SQLite 知识图谱：每个符号、每条边（调用/引用/继承）、每个文件都在其中。查询速度比 grep 快几个数量级，且结果来自完整 AST 解析而非文本匹配。\n\n核心工具：\n- `codegraph_explore` 一次调用返回多个符号的源码 + 调用路径 + 影响范围——替代 grep + Read 循环\n- `codegraph_search` 按名称找符号，返回 kind、位置、签名\n- 文件监控自动增量索引，写代码 500ms 后即可查询\n\n适合大型代码库的结构性探索——\"这个改了什么会坏\"、\"谁调用了这个函数\"这类问题，一键回答。","src/content/projects/codegraph.md","e7c395f34538ae48",{"html":46,"metadata":47},"\u003Cp>CodeGraph 把整个代码库解析成 SQLite 知识图谱：每个符号、每条边（调用/引用/继承）、每个文件都在其中。查询速度比 grep 快几个数量级，且结果来自完整 AST 解析而非文本匹配。\u003C/p>\n\u003Cp>核心工具：\u003C/p>\n\u003Cul>\n\u003Cli>\u003Ccode>codegraph_explore\u003C/code> 一次调用返回多个符号的源码 + 调用路径 + 影响范围——替代 grep + Read 循环\u003C/li>\n\u003Cli>\u003Ccode>codegraph_search\u003C/code> 按名称找符号，返回 kind、位置、签名\u003C/li>\n\u003Cli>文件监控自动增量索引，写代码 500ms 后即可查询\u003C/li>\n\u003C/ul>\n\u003Cp>适合大型代码库的结构性探索——“这个改了什么会坏”、“谁调用了这个函数”这类问题，一键回答。\u003C/p>",{"headings":48,"localImagePaths":49,"remoteImagePaths":50,"frontmatter":51,"imagePaths":53},[],[],[],{"name":37,"description":38,"url":39,"tags":52},[17,41,19],[],"codegraph.md","ponytail",{"id":55,"data":57,"body":65,"filePath":66,"digest":67,"rendered":68,"legacyId":77},{"name":58,"description":59,"url":60,"tags":61},"Ponytail","强制最懒解法——用最短的代码实现功能，类似 YAGNI 原则的产品化实现","https://github.com/ponytail-ai/ponytail",[62,63,64],"开发原则","代码简化","AI辅助","秦马抄（Ponytail）是一种开发方法论，核心是\"爬梯子\"原则：\n\n1. **这个功能真的需要存在吗？**（YAGNI）——不需要就砍\n2. **代码库里已经有了？**——复用，别重造\n3. **标准库有吗？**——用 stdlib\n4. **原生平台功能能覆盖？**——`\u003Cinput type=\"date\">` 优于引入日期选择库\n5. **已安装的依赖能解决？**——别加新依赖\n6. **能一行写完？**——一行\n\n实践中，每当你开始写代码前，从这个梯子的第一级开始往上爬，停在第一个能解决问题的台阶。简单代码不是目标，而是结果——一旦你真的理解了问题，最简单的解法自然会浮现。","src/content/projects/ponytail.md","9da964492a8ac527",{"html":69,"metadata":70},"\u003Cp>秦马抄（Ponytail）是一种开发方法论，核心是”爬梯子”原则：\u003C/p>\n\u003Col>\n\u003Cli>\u003Cstrong>这个功能真的需要存在吗？\u003C/strong>（YAGNI）——不需要就砍\u003C/li>\n\u003Cli>\u003Cstrong>代码库里已经有了？\u003C/strong>——复用，别重造\u003C/li>\n\u003Cli>\u003Cstrong>标准库有吗？\u003C/strong>——用 stdlib\u003C/li>\n\u003Cli>\u003Cstrong>原生平台功能能覆盖？\u003C/strong>——\u003Ccode>&#x3C;input type=\"date\">\u003C/code> 优于引入日期选择库\u003C/li>\n\u003Cli>\u003Cstrong>已安装的依赖能解决？\u003C/strong>——别加新依赖\u003C/li>\n\u003Cli>\u003Cstrong>能一行写完？\u003C/strong>——一行\u003C/li>\n\u003C/ol>\n\u003Cp>实践中，每当你开始写代码前，从这个梯子的第一级开始往上爬，停在第一个能解决问题的台阶。简单代码不是目标，而是结果——一旦你真的理解了问题，最简单的解法自然会浮现。\u003C/p>",{"headings":71,"localImagePaths":72,"remoteImagePaths":73,"frontmatter":74,"imagePaths":76},[],[],[],{"name":58,"description":59,"url":60,"tags":75},[62,63,64],[],"ponytail.md","zustand",{"id":78,"data":80,"body":88,"filePath":89,"digest":90,"rendered":91,"legacyId":100},{"name":81,"description":82,"url":83,"tags":84},"Zustand","极简 React 状态管理——一个 create 函数，没有样板代码","https://github.com/pmndrs/zustand",[85,86,87],"React","状态管理","极简设计","Zustand 证明了状态管理库可以只有几 KB：\n\n```ts\nimport { create } from 'zustand'\nconst useStore = create((set) => ({\n  count: 0,\n  inc: () => set((s) => ({ count: s.count + 1 })),\n}))\n```\n\n没有 Provider 包裹、没有 reducer、没有 action type 常量。它就是普通函数，你可以在组件外使用、在测试中重置、在中间件里扩展。\n\n设计哲学：API 最小化。Redux 那套 action → reducer → selector 链路在 90% 的场景里是过度设计。Zustand 只保留了一个概念——`set`——然后让你用普通的 JS 函数做剩下的事。\n\n这不是偷懒，这是对自己需求的诚实。","src/content/projects/zustand.md","878801578c92fba2",{"html":92,"metadata":93},"\u003Cp>Zustand 证明了状态管理库可以只有几 KB：\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"ts\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">import\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> { create } \u003C/span>\u003Cspan style=\"color:#F97583\">from\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> 'zustand'\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">const\u003C/span>\u003Cspan style=\"color:#79B8FF\"> useStore\u003C/span>\u003Cspan style=\"color:#F97583\"> =\u003C/span>\u003Cspan style=\"color:#B392F0\"> create\u003C/span>\u003Cspan style=\"color:#E1E4E8\">((\u003C/span>\u003Cspan style=\"color:#FFAB70\">set\u003C/span>\u003Cspan style=\"color:#E1E4E8\">) \u003C/span>\u003Cspan style=\"color:#F97583\">=>\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> ({\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  count: \u003C/span>\u003Cspan style=\"color:#79B8FF\">0\u003C/span>\u003Cspan style=\"color:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">  inc\u003C/span>\u003Cspan style=\"color:#E1E4E8\">: () \u003C/span>\u003Cspan style=\"color:#F97583\">=>\u003C/span>\u003Cspan style=\"color:#B392F0\"> set\u003C/span>\u003Cspan style=\"color:#E1E4E8\">((\u003C/span>\u003Cspan style=\"color:#FFAB70\">s\u003C/span>\u003Cspan style=\"color:#E1E4E8\">) \u003C/span>\u003Cspan style=\"color:#F97583\">=>\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> ({ count: s.count \u003C/span>\u003Cspan style=\"color:#F97583\">+\u003C/span>\u003Cspan style=\"color:#79B8FF\"> 1\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> })),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">}))\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>没有 Provider 包裹、没有 reducer、没有 action type 常量。它就是普通函数，你可以在组件外使用、在测试中重置、在中间件里扩展。\u003C/p>\n\u003Cp>设计哲学：API 最小化。Redux 那套 action → reducer → selector 链路在 90% 的场景里是过度设计。Zustand 只保留了一个概念——\u003Ccode>set\u003C/code>——然后让你用普通的 JS 函数做剩下的事。\u003C/p>\n\u003Cp>这不是偷懒，这是对自己需求的诚实。\u003C/p>",{"headings":94,"localImagePaths":95,"remoteImagePaths":96,"frontmatter":97,"imagePaths":99},[],[],[],{"name":81,"description":82,"url":83,"tags":98},[85,86,87],[],"zustand.md"]